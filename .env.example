# Protected /nid_dob page
NID_DOB_PASSWORD=
NID_DOB_SESSION_SECRET=

# Porichoy production provider
PORICHOY_API_KEY=
PORICHOY_BASE_URL=https://api.porichoybd.com
PORICHOY_NID_PATH=/api/v2/verifications/autofill
PORICHOY_BIRTH_PATH=/api/v1/verifications/autofill
PORICHOY_TIMEOUT_MS=15000

# DGHS SHR NID/BRN proxy
# Official documentation currently lists:
# https://nidproxy.mcishr.dghs.gov.bd/verify-and-get-data
DGHS_NID_PROXY_URL=https://nidproxy.mcishr.dghs.gov.bd/verify-and-get-data

# Use credentials issued to your registered DGHS health-care integration.
# Do not copy sample/documentation credentials into production.
DGHS_X_AUTH_TOKEN=
DGHS_CLIENT_ID=
DGHS_EMAIL=
DGHS_PERFORMER=
DGHS_TIMEOUT_MS=15000
