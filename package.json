{
  "name": "pinflix",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 8080",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 8080",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "hls.js": "^1.7.1",
    "lucide-react": "^0.510.0",
    "mpegts.js": "^1.8.2",
    "next": "16.3.4",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.17.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "10.9.1",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.69.0"
  },
  "engines": {
    "node": "24.x"
  }
